# Copy to `.env` and fill in values. Never commit real secrets.

DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/DATABASE_NAME

# Groq (optional depending on features you use)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

PORT=8000
SERVER_LAN_IP=localhost
SECRET_KEY=change-me-in-production

# CORS: include every origin that loads the SPA (comma-separated).
# When using ngrok for the frontend, add your HTTPS origin here, e.g.:
# ALLOWED_ORIGINS=https://YOUR-SUBDOMAIN.ngrok-free.dev
ALLOWED_ORIGINS=http://localhost:5173

# Public HTTPS base URL of the React app. Used for prescan mobile links and as Origin fallback.
# Example: https://YOUR-SUBDOMAIN.ngrok-free.dev
FRONTEND_URL=http://localhost:5173

# Google Sign-In (optional). Web client ID; must match VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_OAUTH_CLIENT_ID=YOUR_ID.apps.googleusercontent.com
# Optional: tolerate clock skew (seconds) if verification errors with "Token used too early"
# GOOGLE_OAUTH_CLOCK_SKEW_SECONDS=120

PRESCAN_SECRET_KEY=change-me-prescan-secret

# Login OTP (optional SMTP — if SMTP_HOST is empty, the OTP is logged on the server for development)
OTP_EXPIRY_MINUTES=10
OTP_MAX_FAILED_ATTEMPTS=5
FIRST_LOGIN_PASSWORD_MIN_LEN=8
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
