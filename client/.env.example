# Copy to `.env` and adjust. Never commit real `.env` files.

# Backend origin used by the SPA (axios, fetch, socket.io).
# - Browsing http://localhost:5173 → http://localhost:8000 is fine.
# - Browsing https://YOUR-APP.ngrok-free.dev → set BOTH VITE_API_URL and VITE_PUBLIC_APP_URL
#   to that same https:// origin so /api is proxied without mixed-content errors.
VITE_API_URL=http://localhost:8000

# Public HTTPS URL of this frontend (same host you open in the browser).
# Required for Vite `allowedHosts` when you use ngrok (or similar) to expose port 5173.
# Example: https://YOUR-SUBDOMAIN.ngrok-free.dev
# Should match backend `FRONTEND_URL` when testing room / environment scan on mobile.
VITE_PUBLIC_APP_URL=

# Google Sign-In (optional). Same value as backend GOOGLE_OAUTH_CLIENT_ID. Leave empty to hide the button.
# OAuth URIs to paste in Google Cloud Console are listed in: google-oauth-console-uris.txt
VITE_GOOGLE_CLIENT_ID=YOUR_ID.apps.googleusercontent.com

# Optional: extra dev hostnames (comma-separated), if you use more than one tunnel.
# VITE_DEV_ALLOWED_HOSTS=other-host.ngrok-free.dev

# Set to true only if you need crossOriginIsolated (e.g. some WebAssembly / TF.js).
# Leave unset/false for Google Sign-In — COOP/COEP break the gsi popup otherwise.
VITE_STRICT_CROSS_ORIGIN_ISOLATION=false
